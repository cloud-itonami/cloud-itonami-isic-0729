{:physics/schema "itonami.physical-ai.spec.v1"
 :repo "cloud-itonami/cloud-itonami-isic-0729"
 :cases
 [{:id :tailings-slurry-line
   :kind :pipe-flow
   :procedure "tailings pump sends flotation tailings slurry through a 200 mm HDPE line to the tailings storage facility"
   :params {:diameter-m 0.20 :length-m 2000.0 :roughness-m 7.0e-6
            :density-kg-m3 1400.0 :viscosity-pa-s 0.005 :pump-efficiency 0.6 :elevation-m 15.0}
   :sweep {:param :q-m3s :values [0.02 0.04 0.06 0.08 0.10]}
   :quantity :pressure-drop-pa
   :limit {:max 1.6e6 :basis "estimate: stay under the 16 bar nominal rating of a PE100 SDR11 line (Newtonian approximation of the slurry)"}
   :boundary {:lo 0.005 :hi 0.3}}
  {:id :core-tray-lift
   :kind :manipulator
   :procedure "core-shed arm lifts a full drill-core tray from the logging bench onto the storage rack"
   :params {:l1-m 0.70 :l2-m 0.60 :m1-kg 12.0 :m2-kg 8.0
            :from [0.70 0.0] :to [0.20 0.90] :duration-s 2.5 :steps 500}
   :sweep {:param :payload-kg :values [5.0 10.0 15.0 20.0 25.0]}
   :quantity :peak-tau1-nm
   :limit {:max 300.0 :basis "estimate: continuous shoulder torque of a ~25 kg payload industrial arm"}
   :boundary {:lo 1.0 :hi 80.0}}]}
